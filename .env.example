# meetmind-v2 settings. Copy to .env and fill in; never commit .env.
# Generate secrets with:  openssl rand -base64 32   (ENCRYPTION_KEY must be exactly that: 32 bytes, base64)

# --- Which stack runs -----------------------------------------------------------------------
# On a host that already runs meetmind (own LiveKit on 7890, HTTPS on 8444, shared model servers):
COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
COMPOSE_PROJECT_NAME=meetmind-v2
PUBLIC_HOST=10.0.0.10                     # the address or name people open in the browser

# --- LiveKit (this app's own server) ---------------------------------------------------------
LIVEKIT_API_KEY=                          # any id, e.g. APImeetmindv2
LIVEKIT_API_SECRET=                       # at least 32 random characters (also in services/livekit/livekit.host.yaml)

# --- Database ---------------------------------------------------------------------------------
DB_PASSWORD=

# --- Call models ------------------------------------------------------------------------------
ASR_URL=http://asr-host:8001              # Parakeet (Riva ASR HTTP API)
S2S_TRANSLATE_API=chat                    # chat = an OpenAI-compatible LLM; riva = Riva Translate
S2S_TRANSLATE_URL=http://llm-host:8000/v1
S2S_TRANSLATE_MODEL=qwen3.8-27b
MAGPIE_TTS_URL=http://tts-host:9000/v1    # Magpie TTS NIM
BNR_GRPC_URL=                             # host:port of NVIDIA BNR for "Studio" noise removal (empty: not offered)
NVIDIA_API_KEY=                           # only for this repo's own model stack

# --- Assistant, summaries and search -----------------------------------------------------------
ASSISTANT_LLM_URL=http://llm-host:8000/v1
ASSISTANT_LLM_MODEL=qwen3.8-27b
EMBEDDING_BASE_URL=http://embed-host:8001/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
ENCRYPTION_KEY=                           # encrypts Uber logins at rest
TRANSCRIPT_RETENTION_DAYS=                # delete saved transcripts N days after a meeting ends (empty: keep)

# --- Optional integrations (empty: the feature says it isn't set up) ---------------------------
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ENV=sandbox                          # production = real rides and real charges
GEOCODER_URL=                             # Nominatim-compatible, for the Open in Uber link
GEOCODER_CONTACT=                         # contact address the geocoder's usage policy asks for
GEOCODER_COUNTRIES=in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                              # a number or a Messaging Service SID (MG…)
SMS_ALLOWED_PREFIXES=+91
SMS_DEV_OUTBOX=false                      # true: texts show on the page instead of being sent (development only)
